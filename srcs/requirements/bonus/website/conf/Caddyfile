# redirect any static website on port 8080 to https

http://:8080 {
	redir https://{host}:443{uri}
}

# serving https only works with a clear domain, needs localhost

localhost:443 {
  root * /srv/www	# document root for all requests
  file_server		# enable static file serving
  tls internal		# create and use a self signed certificate
}

# caddy autoredirect not possible, because localhost might be used by nginx
# need definitive ports for caddy rules
